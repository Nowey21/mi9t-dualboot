From 6342cc6b5d24e3c7e303fac60cedb2a66e790f13 Mon Sep 17 00:00:00 2001
From: Nowey21 <132582838+Nowey21@users.noreply.github.com>
Date: Fri, 6 Nov 2026 15:30:08 +0100
Subject: [PATCH 1/2] Dual boot: root on linux_root (sda22), ESP on linux_esp
 (sda20)

---
 device/configure.sh                        | 6 +++---
 scripts/install/install-kernel-parallel.sh | 2 +-
 scripts/install/install-kernel.sh          | 6 +++---
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/device/configure.sh b/device/configure.sh
index fe4c810..a6fec9a 100755
--- a/device/configure.sh
+++ b/device/configure.sh
@@ -21,9 +21,9 @@ systemctl enable pd-mapper.service rmtfs.service tqftpserv.service \
 # The ESP (systemd-boot, kernel, device tree) for kernel updates later.
 mkdir -p /boot/efi
 cat > /etc/fstab <<'FSTAB'
-# The kernel mounts /dev/sda32 (userdata) as root itself: no initramfs.
-/dev/sda32  /          ext4  defaults,noatime              0 0
-/dev/sda30  /boot/efi  vfat  defaults,noatime,umask=0077,nofail  0 0
+# The kernel mounts /dev/sda22 (linux_root) as root itself: no initramfs.
+/dev/sda22  /          ext4  defaults,noatime              0 0
+/dev/sda20  /boot/efi  vfat  defaults,noatime,umask=0077,nofail  0 0
 FSTAB
 
 dconf update
diff --git a/scripts/install/install-kernel-parallel.sh b/scripts/install/install-kernel-parallel.sh
index 5c0f2d0..fac3643 100755
--- a/scripts/install/install-kernel-parallel.sh
+++ b/scripts/install/install-kernel-parallel.sh
@@ -18,7 +18,7 @@ set -e
 
 KREL=7.1.0-sm7150fix
 TGZ=${1:-/tmp/kernel-fix.tar.gz}
-BOOTDEV=/dev/sda30
+BOOTDEV=/dev/sda20
 BM=/mnt/bootfix
 X=/tmp/kfix
 
diff --git a/scripts/install/install-kernel.sh b/scripts/install/install-kernel.sh
index 354251f..3fd2032 100755
--- a/scripts/install/install-kernel.sh
+++ b/scripts/install/install-kernel.sh
@@ -14,8 +14,8 @@ set -e
 
 KREL=7.1.0-sm7150fix
 TGZ=${1:-/tmp/kernel-fix.tar.gz}
-BOOTDEV=/dev/sda30
-ROOTDEV=/dev/sda32
+BOOTDEV=/dev/sda20
+ROOTDEV=/dev/sda22
 BM=/mnt/bootfix
 X=/tmp/kfix
 # The device tree to boot: the battery tree from this repository, as the
@@ -71,7 +71,7 @@ ls -la "$BM/vmlinuz-fix" "$BM/dtbs/qcom/sm7150-xiaomi-davinci-battery-final.dtb"
 
 step "write the boot entry"
 # root as a device node: without an initramfs the kernel cannot resolve
-# root=UUID=, but it can resolve /dev/sda32. There is only one UFS unit with
+# root=UUID=, but it can resolve /dev/sda22. There is only one UFS unit with
 # partitions, so the naming is stable.
 # 'splash' only with the boot-splash extra installed.
 SPLASH=
-- 
2.53.0

